# Roko server — copy to .env and adjust.

# HTTP port the service listens on.
ROKO_PORT=3100

# Shared secret the bearer JWT is signed/verified with (TEMPORARY auth).
# LibreChat must sign its per-user tokens with the SAME secret.
ROKO_SHARED_SECRET=change-me-dev-secret

# Where the SQLite registry + local filestore bytes live (defaults under ./data).
ROKO_DATA_DIR=./data
# ROKO_FILESTORE_ROOT=./data/filestores
# ROKO_DB_PATH=./data/roko.sqlite
